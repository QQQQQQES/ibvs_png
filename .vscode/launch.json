{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "px4ctrl_node",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/devel/lib/px4_flight_control/px4ctrl_node",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ROS_MASTER_URI",
                    "value": "http://localhost:11311"
                },
                {
                    "name": "ROS_HOSTNAME",
                    "value": "localhost"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build_and_load_px4ctrl",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "调试Step1节点",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/devel/lib/target_detection/step1_node",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ROS_MASTER_URI",
                    "value": "http://localhost:11311"
                },
                {
                    "name": "ROS_HOSTNAME",
                    "value": "localhost"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build_step1_node",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "附加到运行中的ROS节点",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/devel/lib/px4_flight_control/px4ctrl_node",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "调试主程序",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/devel/lib/target_detection/control_system",
